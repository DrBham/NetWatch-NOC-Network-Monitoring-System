# NetWatch NOC — repository safety rules
# Review staged files before every commit; .gitignore is not a secret scanner.

# Credentials and private material
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
private/
private-backups/
raw-exports/
raw-screenshots/

# MikroTik backups and diagnostics
*.backup
*.rif

# RouterOS exports are private by default.
# Publish only manually reviewed, reproducible examples in configs/public/.
*.rsc
!configs/public/*.rsc

# Virtual machines, installers, large binary packages
*.vdi
*.vmdk
*.vhd
*.vhdx
*.qcow2
*.ova
*.ovf
*.iso
*.zip
*.7z
*.tar
*.gz

# Generated data and local editor files
*.log
*.tmp
__pycache__/
.vscode/
